# Claude Code's per-checkout folder (settings, launch configs, worktrees):
# machine-specific, holds local paths. Nothing in it belongs in the repo.
.claude/
# API keys, wherever they land, and anything retired in place rather than deleted.
secret.json
*.retired
.env.bak*
.env.*.bak
docs/
# The optional free voice's model and timing, from npm run add-free-voice. Its
# packages land in free-voice/node_modules/, which node_modules/ above covers.
free-voice/models/
free-voice/speed.json
