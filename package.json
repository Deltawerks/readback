{
  "name": "readback",
  "version": "0.6.2",
  "type": "module",
  "description": "Windows voice for Claude and Codex. Automatically reads replies aloud with Inworld or ElevenLabs, a shared queue, and a GUI control panel.",
  "license": "MIT",
  "bin": {
    "readback-mcp": "src/mcp-server.js"
  },
  "scripts": {
    "mcp": "node src/mcp-server.js",
    "panel": "node src/panel-server.js",
    "say": "node scripts/say.js",
    "voices": "node scripts/voices.js",
    "where": "node scripts/where.js",
    "register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register.ps1",
    "register:codex": "node scripts/register-codex.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Deltawerks/readback.git"
  }
}
