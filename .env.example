# ReadBack reads API keys from the control panel (no file needed). This file is
# an OPTIONAL fallback if you'd rather keep them in a file: copy it to .env in
# this folder. For each provider, a real environment variable wins, then the
# key saved in the panel, then this file.

# Inworld: the SAME base64 string you'd paste into the panel.
# Get one at https://platform.inworld.ai
INWORLD_API_KEY=

# ElevenLabs: a plain API key from https://elevenlabs.io (Profile → API Keys)
ELEVENLABS_API_KEY=

# --- Optional overrides (defaults shown) ---

# Provider for a brand-new install only (inworld or elevenlabs). Once settings
# exist, the provider chosen in the panel wins. A blank value is ignored.
# READBACK_PROVIDER=inworld

# Panel port. The Desktop shortcut and scripts/launch-panel.ps1 always look for
# the panel on 7717, so change this only if you start it with npm run panel.
# READBACK_PORT=7717

# Longest reply ReadBack reads aloud, in characters; past it, ReadBack says the
# rest is on screen. A positive whole number here overrides the saved cap every
# time a reply is read. There is no panel control for it. A blank or invalid
# value is ignored.
# READBACK_MAX_CHARS=12000

# Web origins, comma-separated and exactly as the browser sends them (for
# example https://dashboard.example.com, no trailing slash), that may use the
# panel's /api/state from a browser on this machine: read the saved settings
# (never the keys) and switch master speech on or off. Nothing else. Empty by
# default, which allows no other origin. Only list sites you control.
# READBACK_ALLOWED_ORIGINS=

# Unset by default. Set it to off and the panel never starts the ducking audio
# helper, so ducking does nothing.
# READBACK_DUCKING_HELPER=off

# Paths: settings + your key, and the log / queue / WAV chunks. Set either of
# these for EVERY ReadBack process (panel, MCP server, hook workers) or for none
# of them: when they disagree, the toggle controls files nothing else reads.
# READBACK_STATE_DIR=
# READBACK_CACHE_DIR=
